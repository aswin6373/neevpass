# ---------------------------------------------------------------------------
# NeevPass environment variables
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# Every variable is validated at boot by apps/web/src/lib/env.ts — the app
# refuses to start with a clear error rather than failing later at runtime.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# development | test | production
NODE_ENV=development

# --- Database --------------------------------------------------------------
# Local dev cluster lives in ./.pgdata (see scripts/db.sh). No Docker required.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/neevpass_dev?schema=public"
# Used by integration tests. Truncated between runs.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/neevpass_test?schema=public"

# --- Authentication (Auth.js v5) -------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"
# Base URL of the app. Required in production.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# --- OAuth providers (all optional; credentials sign-in always works) -------
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_LINKEDIN_ID=
# AUTH_LINKEDIN_SECRET=

# --- Application -----------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Where uploaded profile photos are written. Defaults to apps/web/.uploads.
# In production, point this at a mounted persistent volume.
# UPLOAD_DIR=/var/lib/neevpass/uploads
# trace | debug | info | warn | error
LOG_LEVEL=info
