// NeevPass database schema.
//
// Scope: the full Phase 1–5 data model.
//   - Auth.js v5 adapter models (User, Account, Session, VerificationToken)
//   - Profile, the aggregate root that every content table hangs off
//   - All eleven profile content sections
//   - The skill/role taxonomy every career feature depends on
//   - Document outputs (Resume, Portfolio)
//   - Career intelligence (goals, score snapshots, roadmaps, resources)
//   - Opportunities and the student's saved feedback on them
//   - Platform records (FileAsset, AuditEvent)
//
// PRODUCT RULE, ENFORCED BY THIS FILE:
//   There is no `verified`, `verifiedAt`, `verifiedBy` or equivalent column
//   anywhere in this schema, and there must never be one. NeevPass does not
//   verify student-provided information and must not imply that it does.
//
// PRODUCT RULE, ENFORCED BY THE SHAPE OF THIS FILE:
//   Every student-authored table carries `profileId`, so ownership scoping is
//   always a single predicate. There is no cross-student query path: nothing
//   here can list, search or browse students, which is what makes the "no
//   recruiter functionality" rule structural rather than behavioural.

// Prisma 7 uses the `prisma-client` generator, which emits TypeScript source
// into the repository instead of a runtime blob inside node_modules. Two
// consequences worth knowing:
//   - the output directory is gitignored and regenerated by `npm run db:generate`
//   - the generated files are real source, so they are type-checked and bundled
//     like the rest of the workspace
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 no longer accepts a connection URL in the schema. The URL used by
  // Migrate lives in prisma.config.ts, and the runtime client receives a driver
  // adapter (see src/index.ts). This keeps one source of truth for credentials
  // — the environment — instead of two.
}

/// How much of a record is exposed to someone other than its owner.
/// See packages/domain/src/profile/visibility.ts for the rules that operate on
/// these values. A new account is PRIVATE in every respect.
enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

/// One table with a `type` discriminator. The UI presents Internships and
/// Experience as separate sections, but they share every field and every
/// rendering path — two tables would mean duplicated validation, duplicated
/// rendering and duplicated taxonomy joins for no gain.
enum ExperienceType {
  INTERNSHIP
  FULL_TIME
  PART_TIME
  FREELANCE
  VOLUNTEER
  APPRENTICESHIP
}

enum WorkMode {
  REMOTE
  ONSITE
  HYBRID
}

/// How an academic result is expressed. The value itself is a string because
/// students type "8.7" or "87%" with equal confidence.
enum GradeType {
  CGPA_10
  CGPA_4
  PERCENTAGE
}

enum OpportunityType {
  INTERNSHIP
  JOB
  HACKATHON
  COMPETITION
  SCHOLARSHIP
  WORKSHOP
}

/// The student's own feedback on an opportunity. `DISMISSED` feeds the
/// recommender; it is not a hidden state, items can be un-dismissed.
enum SavedOpportunityStatus {
  SAVED
  APPLIED
  DISMISSED
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  PAUSED
  DROPPED
}

enum GoalPriority {
  HIGH
  MEDIUM
  LOW
}

enum RoadmapItemStatus {
  TODO
  IN_PROGRESS
  DONE
  SKIPPED
}

enum ResourceKind {
  ARTICLE
  VIDEO
  COURSE
  DOCS
  BOOK
}

// ---------------------------------------------------------------------------
// Identity (Auth.js v5 adapter contract)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  /// Null for accounts created through an OAuth provider only.
  /// Never selected into an API response.
  passwordHash String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts   Account[]
  sessions   Session[]
  assets     FileAsset[]
  profile    Profile?
  auditEvents AuditEvent[]

  @@index([email])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Profile — the aggregate root
// ---------------------------------------------------------------------------

/// One profile per user. Every content table references this row, and ownership
/// is always checked by looking up this record for the current session's user.
model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName String
  headline String?
  summary  String?
  location String?
  phone    String?

  /// Address of the public career page, e.g. /p/aswin-kumar.
  /// Null until the student claims one. Reserved words are rejected in the
  /// domain layer (see RESERVED_SLUGS) so a slug can never shadow a route.
  publicSlug String? @unique

  /// Applied to new sections and items. Existing rows keep their own value.
  defaultVisibility Visibility @default(PRIVATE)

  /// Optimistic concurrency token. Incremented on every accepted write so two
  /// browser tabs cannot silently overwrite each other.
  revision Int @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  education    Education[]
  experience   Experience[]
  projects     Project[]
  certificates Certificate[]
  achievements Achievement[]
  hackathons   Hackathon[]
  workshops    Workshop[]
  links        ProfileLink[]
  skills       ProfileSkill[]
  resumes      Resume[]
  portfolios   Portfolio[]
  goals        CareerGoal[]
  roadmaps     Roadmap[]
  scores       CareerScoreSnapshot[]
  saved        SavedOpportunity[]

  @@index([publicSlug])
}

// ---------------------------------------------------------------------------
// Profile content — the eleven sections
// ---------------------------------------------------------------------------

/// Dates are stored at month precision (first day of the month) because
/// students rarely know exact days. `fromDate` is required; `toDate` is null
/// while `isCurrent` is true.
model Education {
  id          String  @id @default(cuid())
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution String
  degree      String
  field       String?
  gradeType   GradeType?
  gradeValue  String?
  location    String?
  fromDate    DateTime
  toDate      DateTime?
  isCurrent   Boolean  @default(false)
  notes       String?
  order       Int      @default(0)
  visibility  Visibility @default(PRIVATE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([profileId, order])
}

model Experience {
  id           String         @id @default(cuid())
  profileId    String
  profile      Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type         ExperienceType
  organisation String
  title        String
  location     String?
  workMode     WorkMode?
  fromDate     DateTime
  toDate       DateTime?
  isCurrent    Boolean        @default(false)
  summary      String?
  highlights   String[]
  order        Int            @default(0)
  visibility   Visibility     @default(PRIVATE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  skills ExperienceSkill[]

  @@index([profileId, type, order])
}

model Project {
  id        String    @id @default(cuid())
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title     String
  role      String?
  summary   String?
  fromDate  DateTime?
  toDate    DateTime?
  isCurrent Boolean   @default(false)
  repoUrl   String?
  liveUrl   String?
  order     Int       @default(0)
  visibility Visibility @default(PRIVATE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  skills ProjectSkill[]

  @@index([profileId, order])
}

/// Certificates are self-reported. The `credentialUrl` points at the issuing
/// body's own site; nothing here, and nothing in any renderer, may present a
/// certificate as verified by NeevPass.
model Certificate {
  id            String    @id @default(cuid())
  profileId     String
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title         String
  issuer        String
  issuedAt      DateTime
  expiresAt     DateTime?
  credentialId  String?
  credentialUrl String?
  summary       String?
  order         Int       @default(0)
  visibility    Visibility @default(PRIVATE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  skills CertificateSkill[]

  @@index([profileId, order])
}

model Achievement {
  id          String    @id @default(cuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  category    String?
  issuer      String?
  issuedAt    DateTime
  description String?
  url         String?
  order       Int       @default(0)
  visibility  Visibility @default(PRIVATE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([profileId, order])
}

model Hackathon {
  id          String    @id @default(cuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  organiser   String?
  heldOn      DateTime
  role        String?
  teamSize    Int?
  projectName String?
  projectUrl  String?
  result      String?
  summary     String?
  order       Int       @default(0)
  visibility  Visibility @default(PRIVATE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  skills HackathonSkill[]

  @@index([profileId, order])
}

model Workshop {
  id            String    @id @default(cuid())
  profileId     String
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title         String
  organiser     String?
  heldOn        DateTime
  durationHours Float?
  mode          WorkMode?
  summary       String?
  credentialUrl String?
  order         Int       @default(0)
  visibility    Visibility @default(PRIVATE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  skills WorkshopSkill[]

  @@index([profileId, order])
}

model ProfileLink {
  id         String    @id @default(cuid())
  profileId  String
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  label      String
  url        String
  order      Int       @default(0)
  visibility Visibility @default(PRIVATE)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([profileId, order])
}

/// A student's self-assessed skill. The taxonomy row is global reference data;
/// the proficiency, years and order belong to the profile.
model ProfileSkill {
  profileId   String
  skillId     String
  proficiency Int      // 1..5, self-assessed. Validated in the domain layer.
  yearsUsed   Float?
  order       Int      @default(0)
  visibility  Visibility @default(PRIVATE)
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@id([profileId, skillId])
  @@index([profileId, order])
}

// ---------------------------------------------------------------------------
// Taxonomy — global reference data, seeded and versioned
// ---------------------------------------------------------------------------

model SkillCategory {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  parentId String?
  parent   SkillCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children SkillCategory[] @relation("CategoryTree")
  skills   Skill[]
}

model Skill {
  id              String  @id @default(cuid())
  slug            String  @unique
  name            String
  aliases         String[]
  categoryId      String?
  category        SkillCategory? @relation(fields: [categoryId], references: [id])
  taxonomyVersion Int     @default(1)

  profileSkills ProfileSkill[]
  projects      ProjectSkill[]
  experiences   ExperienceSkill[]
  certificates  CertificateSkill[]
  hackathons    HackathonSkill[]
  workshops     WorkshopSkill[]
  requiredBy    RoleSkillRequirement[]
  opportunities OpportunitySkill[]
  resources     Resource[]
  roadmapItems  RoadmapItem[]
  prerequisites SkillPrerequisite[] @relation("SkillRequires")
  unlocks       SkillPrerequisite[] @relation("RequiredForSkill")
}

/// skill → a skill it builds on. A directed acyclic graph by construction
/// (seed data); cycles are rejected by the roadmap engine's depth guard.
model SkillPrerequisite {
  skillId        String
  prerequisiteId String
  skill          Skill @relation("SkillRequires", fields: [skillId], references: [id], onDelete: Cascade)
  prerequisite   Skill @relation("RequiredForSkill", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([skillId, prerequisiteId])
}

model Role {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  category    String?
  description String?

  requirements RoleSkillRequirement[]
  goals        CareerGoal[]
  roadmaps     Roadmap[]
}

/// The weighted skill requirements of a target role. `importance` and
/// `minLevel` are 1..5; both are domain-validated before use.
model RoleSkillRequirement {
  roleId     String
  skillId    String
  importance Int // 1..5
  minLevel   Int // 1..5
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  skill      Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([roleId, skillId])
}

// ---------------------------------------------------------------------------
// Content ↔ skill joins
// One join table per content type, so gap analysis can attribute evidence of a
// skill to the project, job or certificate that demonstrates it.
// ---------------------------------------------------------------------------

model ExperienceSkill {
  experienceId String
  skillId      String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([experienceId, skillId])
}

model ProjectSkill {
  projectId String
  skillId   String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
}

model CertificateSkill {
  certificateId String
  skillId       String
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  skill         Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([certificateId, skillId])
}

model HackathonSkill {
  hackathonId String
  skillId     String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([hackathonId, skillId])
}

model WorkshopSkill {
  workshopId String
  skillId    String
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([workshopId, skillId])
}

// ---------------------------------------------------------------------------
// Outputs — resumes and portfolios, both built from profile snapshots
// ---------------------------------------------------------------------------

/// `config` holds a ResumeConfig (see @neevpass/docgen): section order, hidden
/// items, item limits and theme overrides. Stored as JSON because it is
/// document configuration, not relational data; it is normalised on read by
/// `normaliseResumeConfig`, so a malformed value can never reach a renderer.
model Resume {
  id           String    @id @default(cuid())
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title        String
  templateKey  String
  config       Json
  targetRoleId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([profileId])
}

model Portfolio {
  id          String    @id @default(cuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  templateKey String
  config      Json

  /// Address of the public portfolio page, e.g. /u/aswin-kumar.
  /// Independent of the career-page slug: a student may want /p/adata and
  /// /u/ashadesigns to differ.
  publicSlug  String?   @unique
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([profileId])
}

// ---------------------------------------------------------------------------
// Career intelligence
// ---------------------------------------------------------------------------

model CareerGoal {
  id        String       @id @default(cuid())
  profileId String
  profile   Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  targetDate DateTime?
  priority  GoalPriority @default(MEDIUM)
  status    GoalStatus   @default(ACTIVE)
  note      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  roadmap Roadmap?

  @@index([profileId, status])
}

/// A point-in-time score. History is kept, never overwritten: the rubric
/// version and profile revision travel with each row, so a diff is explainable
/// and a rubric change never rewrites the past.
model CareerScoreSnapshot {
  id              String   @id @default(cuid())
  profileId       String
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  score           Int
  breakdown       Json
  rubricVersion   Int
  profileRevision Int
  computedAt      DateTime @default(now())

  @@index([profileId, computedAt])
}

model Roadmap {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  goalId    String?  @unique
  goal      CareerGoal? @relation(fields: [goalId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  /// Bumped every time the roadmap is regenerated from a new gap analysis, so
  /// a student's checked-off milestones survive a recompute via the merge
  /// logic in the roadmap service.
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items RoadmapItem[]

  @@index([profileId])
}

model RoadmapItem {
  id        String            @id @default(cuid())
  roadmapId String
  roadmap   Roadmap           @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)
  order     Int
  status    RoadmapItemStatus @default(TODO)

  /// Why this item is on the roadmap. A milestone with no stated reason is a
  /// bug — the same rule as recommendations.
  reason     String
  resourceId String?
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  updatedAt  DateTime  @updatedAt

  @@unique([roadmapId, skillId])
  @@index([roadmapId, order])
}

/// Curated learning resources, tagged by the primary skill they teach.
/// Seed-managed reference data, like the taxonomy itself.
model Resource {
  id       String       @id @default(cuid())
  slug     String       @unique
  title    String
  url      String
  provider String?
  kind     ResourceKind
  free     Boolean      @default(true)
  skillId  String
  skill    Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  roadmapItems RoadmapItem[]
}

// ---------------------------------------------------------------------------
// Opportunities
// ---------------------------------------------------------------------------

/// An externally-hosted opportunity. NeevPass lists it and links out; the
/// application itself always happens on the organiser's site.
model Opportunity {
  id           String          @id @default(cuid())
  slug         String          @unique
  title        String
  organiser    String
  type         OpportunityType
  description  String
  url          String
  location     String?
  workMode     WorkMode?
  deadline     DateTime?
  compensation String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  skills OpportunitySkill[]
  savedBy SavedOpportunity[]

  @@index([type, isActive])
  @@index([deadline])
}

model OpportunitySkill {
  opportunityId String
  skillId       String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  skill         Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([opportunityId, skillId])
}

model SavedOpportunity {
  profileId     String
  opportunityId String
  status        SavedOpportunityStatus @default(SAVED)
  savedAt       DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  profile       Profile                @relation(fields: [profileId], references: [id], onDelete: Cascade)
  opportunity   Opportunity            @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@id([profileId, opportunityId])
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

/// Metadata for an uploaded file. The bytes live in object storage; this row is
/// the ownership record that makes an upload addressable and deletable.
model FileAsset {
  id         String    @id @default(cuid())
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// Opaque key in the storage bucket. Never derived from a user-supplied name.
  storageKey String  @unique

  /// Validated server-side against an allow-list, not trusted from the client.
  mimeType String
  byteSize Int
  width    Int?
  height   Int?

  /// What the file is for, e.g. "project-image" or "certificate-scan".
  purpose String

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([ownerId, purpose])
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

/// Significant account and publishing actions, for support and debugging.
/// Never contains PII beyond the acting user's id — the logger's redaction
/// rules apply to whatever is written into `metadata`.
model AuditEvent {
  id       String   @id @default(cuid())
  userId   String?
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action   String
  metadata Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}
