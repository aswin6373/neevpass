{
  "name": "@neevpass/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prisma schema, generated client, repositories and seed data.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "prisma generate",
    "db:validate": "node scripts/run-with-env.mjs prisma validate",
    "db:migrate": "node scripts/run-with-env.mjs prisma migrate dev",
    "db:deploy": "node scripts/run-with-env.mjs prisma migrate deploy",
    "db:push": "node scripts/run-with-env.mjs prisma db push",
    "db:seed": "node scripts/run-with-env.mjs tsx src/seed.ts",
    "db:studio": "node scripts/run-with-env.mjs prisma studio",
    "db:reset": "node scripts/run-with-env.mjs prisma migrate reset --force"
  },
  "dependencies": {
    "@neevpass/domain": "*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
