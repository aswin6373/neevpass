{
  "name": "neevpass",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "NeevPass — create your professional profile once and use it everywhere.",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @neevpass/web",
    "build": "npm run build --workspace @neevpass/web",
    "start": "node scripts/start-prod.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "db:up": "bash scripts/db.sh start",
    "db:down": "bash scripts/db.sh stop",
    "db:status": "bash scripts/db.sh status",
    "db:generate": "npm run db:generate --workspace @neevpass/db",
    "db:migrate": "npm run db:migrate --workspace @neevpass/db",
    "db:deploy": "npm run db:deploy --workspace @neevpass/db",
    "db:push": "npm run db:push --workspace @neevpass/db",
    "db:seed": "npm run db:seed --workspace @neevpass/db",
    "db:studio": "npm run db:studio --workspace @neevpass/db",
    "db:reset": "npm run db:reset --workspace @neevpass/db"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
